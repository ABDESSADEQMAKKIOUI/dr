# Rendered to /etc/nginx/conf.d/default.conf by bootstrap.sh, which replaces the
# __PLACEHOLDER__ tokens with sed. Plain sed rather than envsubst so that nginx's
# own $variables can never be eaten by the substitution.
#
# FIVE server blocks, in the order nginx resolves them for a given Host:
#
#   1. port 80, default_server        every host: ACME challenge, then -> https
#   2. apex        __SERVER_NAME__    the public landing page (public by default)
#   3. admin       __ADMIN_SERVER_NAME__  the operator console (public by default)
#   4. wildcard    *.__ROOT_DOMAIN__  tenants with no certificate yet
#                                     (self-signed placeholder, NO basic auth)
#   5. port 443, default_server       anything else -> 404
#
# Tenants that DO have a certificate get their own exact-match server block from
# conf/tenant.conf.template, rendered into conf.d/tenant-<host>.conf. nginx
# matches an exact server_name before a leading wildcard before default_server,
# so those blocks win over (4) automatically and (4) is purely the fallback.

# ── Port 80 — one block for every host on the box ─────────────────────────────
# This is the block that makes per-tenant HTTP-01 issuance possible: a brand new
# tenant has no vhost of its own, so its challenge has to be answered by the
# default_server. It must stay above every redirect and outside basic auth.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── Apex — __SERVER_NAME__ ────────────────────────────────────────────────────
# PUBLIC by default. This host serves routes/site.php: the SAFM landing page,
# the feature and pricing sections, and the "request a demo" form. A basic-auth
# prompt in front of a marketing page defeats its entire purpose, so the gate is
# opt-in. Set SAFM_APEX_BASIC_AUTH=true to close it again — useful on a staging
# domain, or before the landing page is ready to be seen.
#
# The same switch drives the X-Robots-Tag below: a public apex is meant to be
# found, so it invites crawlers; a gated apex keeps the noindex it has today.
#
# (Comments here must not spell the placeholder tokens out — bootstrap.sh runs a
# plain sed over this whole file and would substitute them inside the prose too.)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __SERVER_NAME__;

    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 40m;

    # The ONLY vhost whose robots policy is conditional. admin and the tenant
    # hosts stay noindex unconditionally — neither is ever meant to be crawled.
    __APEX_ROBOTS__
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    __APEX_HSTS__

    access_log /dev/stdout main;
    error_log  /dev/stderr warn;

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/certbot;
        default_type "text/plain";
    }

    # config/filesystems.php:44 builds the public disk URL as env('APP_URL') .
    # '/storage', and APP_URL can only ever name ONE host — the apex. So a
    # tenant page rendering an uploaded employee photo or expense attachment
    # (Storage::url(), four call sites) points the browser at
    # https://<apex>/storage/... . With the apex behind basic auth those four
    # images 401 — which is why this location keeps its OWN toggle instead of
    # following the one on `location /` below: uploads must keep working even on
    # a deployment that has re-gated the apex with SAFM_APEX_BASIC_AUTH=true.
    # The auth_basic here is `off` when SAFM_PUBLIC_STORAGE=true, which is what
    # the production overlay sets. Uploaded public-disk files are not
    # credentials; the ERP itself stays gated.
    location ^~ /storage/ {
        auth_basic           __APEX_STORAGE_AUTH__;
        auth_basic_user_file /etc/nginx/safm.htpasswd;

        proxy_pass http://__UPSTREAM__;
        include /etc/nginx/safm-proxy.conf;
    }

    # The auth_basic below renders as `off` unless SAFM_APEX_BASIC_AUTH=true.
    # Off is the default because everything this host serves is public by design.
    location / {
        auth_basic           __APEX_AUTH__;
        auth_basic_user_file /etc/nginx/safm.htpasswd;

        proxy_pass http://__UPSTREAM__;
        include /etc/nginx/safm-proxy.conf;
    }
}

# ── Operator console — __ADMIN_SERVER_NAME__ ──────────────────────────────────
# PUBLIC by default. This host serves routes/platform.php: tenant provisioning,
# tenant destruction, plans and the audit log — so it is the highest-value target
# in the system, and it is protected by its own login guard, per-ability
# authorisation and a 5-per-minute throttle on the login form rather than by a
# shared password every operator would otherwise have to be given.
# Set SAFM_ADMIN_BASIC_AUTH=true to put a second lock back in front of it.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __ADMIN_SERVER_NAME__;

    ssl_certificate     __ADMIN_SSL_CERT__;
    ssl_certificate_key __ADMIN_SSL_KEY__;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 40m;

    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    __ADMIN_HSTS__

    access_log /dev/stdout main;
    error_log  /dev/stderr warn;

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        auth_basic           __ADMIN_AUTH__;
        auth_basic_user_file /etc/nginx/safm.htpasswd;

        proxy_pass http://__UPSTREAM__;
        include /etc/nginx/safm-proxy.conf;
    }
}

# ── Tenant fallback — *.__ROOT_DOMAIN__ ───────────────────────────────────────
# Serves the SELF-SIGNED placeholder, so a tenant is usable the second it is
# provisioned, before certbot has answered. Once conf.d/tenant-<host>.conf
# exists for that host, this block stops seeing it.
#
# No basic auth by default: this is where real customers land.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name *.__ROOT_DOMAIN__;

    ssl_certificate     __FALLBACK_SSL_CERT__;
    ssl_certificate_key __FALLBACK_SSL_KEY__;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 40m;

    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    access_log /dev/stdout main;
    error_log  /dev/stderr warn;

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        auth_basic           __TENANT_AUTH__;
        auth_basic_user_file /etc/nginx/safm.htpasswd;

        proxy_pass http://__UPSTREAM__;
        include /etc/nginx/safm-proxy.conf;
    }
}

# ── Everything else ───────────────────────────────────────────────────────────
# An IP-address request, a stale DNS name, a scanner probing Host: localhost.
# Without this block nginx would hand those to the FIRST 443 server block (the
# apex), which would proxy them into Laravel with an unroutable Host. A 404 at
# the edge keeps them out of PHP entirely.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     __FALLBACK_SSL_CERT__;
    ssl_certificate_key __FALLBACK_SSL_KEY__;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    access_log off;

    return 404;
}

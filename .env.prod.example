# Production settings for the SAFM SaaS platform.
#
#   cp .env.prod.example .env
#
# Docker Compose reads .env from this directory automatically. It is host-side
# only and is NOT the application's .env — that one is generated inside the app
# container by docker/entrypoint.sh from the values in docker-compose.yml and
# docker-compose.prod.yml.
#
# .env is gitignored. Do not commit it.

# ── Domains ───────────────────────────────────────────────────────────────────
# DNS, both records required:
#
#   facturation.cfpss.ma      A   <this server>
#   *.facturation.cfpss.ma    A   <this server>     <-- the wildcard is mandatory
#
# The wildcard is what makes a new tenant reachable the instant it is
# provisioned, and it is what lets certbot answer the per-subdomain HTTP-01
# challenge. Certificates are issued per subdomain over HTTP-01, so no DNS API
# token is needed anywhere in this stack.
SAFM_SERVER_NAME=facturation.cfpss.ma

# Optional overrides. Leave them empty and the stack derives:
#   root domain  = SAFM_SERVER_NAME
#   admin host   = admin.<root domain>
# Set them only if the marketing apex and the tenant zone are different names.
SAFM_ROOT_DOMAIN=
SAFM_ADMIN_SERVER_NAME=

# ── Gate in front of the apex and the operator console ────────────────────────
# HTTP basic auth, applied by nginx to the apex and to admin.<root>.
# nginx REFUSES TO START if these are unset — that is deliberate.
# Pick a long random password; anyone with it reaches the operator console login.
SAFM_AUTH_USER=demo
SAFM_AUTH_PASSWORD=

# Shown in the browser's credential prompt.
# Quoted because the value contains a space: Compose parses this file fine
# either way, but `set -a; . ./.env` in a shell would choke without the quotes.
SAFM_AUTH_REALM="SAFM"

# TENANT SUBDOMAINS ARE NOT BASIC-AUTH GATED BY DEFAULT, and that is the point:
# a paying customer must not be handed the shared demo password to reach their
# own ERP. Their protection is the ERP login itself.
# Set to true ONLY on a staging domain where even tenant hosts must stay private.
SAFM_TENANT_BASIC_AUTH=false

# Lets /storage/ through basic auth on the apex only. config/filesystems.php
# builds the public disk URL from APP_URL, which can name exactly one host, so
# Storage::url() sends every tenant's employee photos and expense attachments to
# https://<apex>/storage/... . Behind basic auth those render as 401s on the
# customer's own page. Leave true unless you have moved uploads to S3.
SAFM_PUBLIC_STORAGE=true

# ── TLS ───────────────────────────────────────────────────────────────────────
# Registration address for Let's Encrypt. Without it no certificate can be
# issued: issue-tenant-cert.sh logs and skips, tenants stay on the self-signed
# wildcard fallback, and browsers show a warning on every tenant subdomain.
SAFM_CERT_EMAIL=

# "true" uses the Let's Encrypt STAGING CA — untrusted certificates, effectively
# unlimited issuance. Turn it on while testing the provisioning flow end to end,
# then turn it off and delete the staging certs from the certbot_conf volume.
#
# WHY THIS EXISTS: the production CA allows 50 certificates per registered
# domain per week, and every tenant subdomain draws from that ONE bucket. A
# scripted test that provisions twenty tenants burns nearly half a week's budget
# and locks out real customers.
SAFM_CERT_STAGING=false

# ── Operator console ──────────────────────────────────────────────────────────
# The first account for admin.<root>/login, created once on first boot.
# Leave the password empty and the entrypoint generates one and prints it ONCE
# in the app container log. Set it here to pin it.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_PASSWORD=

# ── Database ──────────────────────────────────────────────────────────────────
# In SaaS mode the application connects as ROOT, because provisioning issues
# CREATE DATABASE and DROP DATABASE — grants the `safm` user does not hold on
# *.*. DB_ROOT_PASSWORD is therefore MANDATORY; the app container refuses to
# boot without it.
#
# DB_DATABASE / DB_USERNAME / DB_PASSWORD below configure the mysql container's
# bootstrap schema and user. They are what the stack falls back to if you ever
# set TENANCY_ENABLED=false. The application does NOT connect to DB_DATABASE in
# SaaS mode — it points at a sentinel schema (safm_unassigned) that must never
# exist, so an unresolved tenant fails with "Unknown database" instead of
# silently reading someone else's data. Never name DB_DATABASE safm_unassigned.
DB_DATABASE=safm
DB_USERNAME=safm
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────
# Host port for debugging the app container directly, bound to loopback.
APP_PORT=8088

# Single-tenant mode only (TENANCY_ENABLED=false). In SaaS mode demo content is
# a `php artisan tenant:provision` decision, not a boot-time one.
DEMO_SEED=true

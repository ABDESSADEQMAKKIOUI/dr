# Production settings for the public demo.
#
#   cp .env.prod.example .env
#
# Docker Compose reads .env from this directory automatically. It is host-side
# only and is NOT the application's .env — that one is generated inside the app
# container from the values in docker-compose.yml.
#
# .env is gitignored. Do not commit it.

# ── Domain ────────────────────────────────────────────────────────────────────
# The DNS A record must already point at this server.
SAFM_SERVER_NAME=facturation.cfpss.ma

# ── Gate in front of the demo ─────────────────────────────────────────────────
# HTTP basic auth, applied by nginx to everything except the ACME challenge.
# nginx REFUSES TO START if these are unset — that is deliberate.
# Pick a long random password; anyone with it reaches the ERP login page.
SAFM_AUTH_USER=demo
SAFM_AUTH_PASSWORD=

# Shown in the browser's credential prompt.
SAFM_AUTH_REALM=SAFM Demo

# ── Database ──────────────────────────────────────────────────────────────────
# Change these from the defaults before going public.
DB_DATABASE=safm
DB_USERNAME=safm
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────
# Host port for debugging the app container directly, bound to loopback.
APP_PORT=8088

# Set to "false" for an instance with no demo catalogue — only roles,
# permissions, settings and the admin account.
DEMO_SEED=true
